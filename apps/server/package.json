{
  "name": "@graft/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "keys": "tsx src/scripts/generate-keys.ts",
    "mint": "tsx src/scripts/mint-token.ts",
    "sweep": "tsx src/scripts/sweep.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc -p tsconfig.json",
    "publish-fixture": "tsx src/scripts/publish-fixture.ts",
    "pipedream-proof": "tsx src/scripts/pipedream-proof.ts",
    "pipedream-proof-agent": "tsx src/scripts/pipedream-proof-agent.ts"
  },
  "dependencies": {
    "@graft/ask-card": "workspace:*",
    "@graft/auth": "workspace:*",
    "@graft/core": "workspace:*",
    "@graft/db": "workspace:*",
    "@graft/email": "workspace:*",
    "@graft/env": "workspace:*",
    "@graft/mcp": "workspace:*",
    "@graft/model": "workspace:*",
    "@graft/observability": "workspace:*",
    "@graft/pipedream": "workspace:*",
    "@graft/proxy": "workspace:*",
    "@graft/publish": "workspace:*",
    "@graft/sandbox": "workspace:*",
    "@graft/sandbox-docker": "workspace:*",
    "@graft/token": "workspace:*",
    "@graft/toolbox": "workspace:*",
    "@graft/vault": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "catalog:",
    "evlog": "^2.29.0",
    "hono": "catalog:",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@graft/cloud-backings": "workspace:*"
  },
  "devDependencies": {
    "@graft/config": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
