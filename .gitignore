# Dependencies
node_modules

# Build outputs
dist
*.tsbuildinfo

# Turbo
.turbo

# Test coverage
coverage

# Environment variables
.env
.env*.local

# A laptop's toolboxes: `GRAFT_TOOLBOX_ROOT` defaults here (`@graft/toolbox`), one directory per
# person, versions with their node_modules inside. A deployment sets an absolute path elsewhere.
.graft/

# Agent worktrees. Claude Code puts them inside the repo, so without this a second checkout shows
# up in `git status` and a `git add -A` can commit it. Only this subdirectory; the rest of
# `.claude/` is tracked once it exists.
.claude/worktrees/

# Logs and editor litter
*.log
.DS_Store

# The hosted form's backings are a private package placed here as `packages/cloud-backings/` when a
# checkout links it in (ADR 0002: the commercial half is hidden by absence). The workspace glob picks
# it up whenever it is present; git never does, so a linked checkout cannot commit it here.
packages/cloud-backings/
