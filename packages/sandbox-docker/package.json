  },
  "dependencies": {
    "@graft/sandbox": "workspace:*",
    "@graft/toolbox": "workspace:*",
    "tar-stream": "catalog:"
  },
  "devDependencies": {
    "@graft/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/tar-stream": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
